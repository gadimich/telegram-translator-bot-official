# Telegram bot token from @BotFather
BOT_TOKEN=your-telegram-bot-token-here

# OpenAI API key
OPENAI_API_KEY=sk-proj-...

# Optional: where to send the translated voice.
# Leave empty to reply in the same chat where you sent the voice.
# To forward elsewhere: numeric chat_id (e.g. 123456789) or @channel_username.
# (For a private user chat, that user must have messaged the bot at least once.)
FORWARD_TO=

# Comma-separated Telegram user IDs allowed to use the bot.
# Find your ID by sending /start to the bot.
# Leave empty to allow ANYONE — strongly discouraged (your OpenAI bill is at risk).
ALLOWED_USERS=123456789

# Optional: TTS voice (alloy, echo, fable, onyx, nova, shimmer).
# nova handles Spanish naturally.
# TTS_VOICE=nova
